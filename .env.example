# 5E47 Platform — example env
# Auth (Clerk or Auth0)
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Database (Supabase / Postgres)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Storage / Media
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Access control
KISI_API_KEY=
OPENPATH_API_KEY=

# Workflow
TEMPORAL_ADDRESS=
TRIGGERDEV_API_KEY=

# AI
OPENAI_API_KEY=
PINECONE_API_KEY=

# Landing imagery
# Set to "true" once /public/landing/ is populated. See the README in that
# folder for the expected filenames. Default false keeps the hand-crafted
# SVG fallbacks in place.
NEXT_PUBLIC_USE_LANDING_PHOTOS=false
